/* Shared layout. Colors and control styling live in ModSDKWindowTheme.uss. */

.main-root {
    flex-direction: row;
    flex-grow: 1;
}

.tabs-panel {
    width: 190px;
    flex-shrink: 0;
    padding: 6px 0;
}

.content-panel {
    flex-grow: 1;
    min-width: 360px;
    padding: 14px 18px;
}

.view {
    flex-grow: 1;
    display: none;
}

.window-title {
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-align: upper-center;
    margin-bottom: 12px;
}

.info-text {
    white-space: normal;
    -unity-text-align: upper-center;
    margin: 0 8px 14px;
}

.tab-button {
    margin: 3px 10px;
    height: 28px;
    -unity-text-align: middle-center;
    -unity-font-style: normal;
    transition-duration: 0.08s;
}

.tab-button--selected {
    -unity-font-style: bold;
}

.tab-button--secondary {
    margin-top: 18px;
}

.section-card {
    padding: 10px;
    margin-bottom: 12px;
}

.field-row {
    margin-bottom: 6px;
    -unity-text-align: middle-left;
}

.field-wide {
    min-width: 300px;
}

.hint-text {
    white-space: normal;
    margin: 0 2px 6px;
}

.description-field {
    flex-direction: row;
    align-items: center;
}

.description-status-button {
    flex-grow: 1;
    min-width: 0;
    height: 20px;
    margin: 0;
    padding-left: 3px;
    padding-right: 3px;
    white-space: normal;
    -unity-text-align: middle-left;
}

.action-button {
    height: 24px;
    margin-top: 4px;
}

.button-group {
    align-items: stretch;
    margin-top: 6px;
}

.thumbnail-preview {
    width: 280px;
    height: 160px;
    margin: 12px 0;
    align-self: center;
    -unity-background-scale-mode: scale-and-crop;
}

.tag-list {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
    margin: 6px 0 16px;
}

.tag-button {
    display: none;
    margin: 0 4px 4px 0;
    font-size: 10px;
}

.TagBase {
    margin: 0 4px 4px 0;
    padding: 2px 8px;
    height: 20px;
    -unity-text-align: middle-center;
}

.workshop-additional-media > .unity-foldout__content {
    margin-left: 0;
    padding-left: 0;
}

.workshop-additional-media #SteamVideoUrl {
    margin-top: 12px;
}

.workshop-media-separator {
    height: 1px;
    flex-shrink: 0;
    margin: 12px 2px;
}

.theme-separator {
    height: 1px;
    flex-shrink: 0;
    margin: 12px 10px 6px;
}

.theme-separator,
.workshop-media-separator {
    background-color: var(--unity-colors-default-border);
}
