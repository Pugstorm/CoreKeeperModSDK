.main-root {
    flex-direction: row;
    flex-grow: 1;
    background-color: rgb(46, 56, 70);
    border-width: 2px;
    border-color: rgb(94, 112, 138);
    border-radius: 0;
}

.tabs-panel {
    width: 190px;
    flex-shrink: 0;
    padding: 6px 0;
    background-color: rgb(38, 47, 60);
    border-right-width: 2px;
    border-right-color: rgb(94, 112, 138);
}

.content-panel {
    flex-grow: 1;
    min-width: 360px;
    padding: 14px 18px;
}

.view {
    flex-grow: 1;
    display: none;
}



.window-title {
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-align: upper-center;
    margin-bottom: 12px;
    color: rgb(231, 231, 231);
}

.info-text {
    white-space: normal;
    -unity-text-align: upper-center;
    margin: 0 8px 14px;
    color: rgb(172, 190, 210);
}



.tab-button {
    margin: 3px 10px;
    height: 28px;
    border-radius: 0;
    border-width: 1px;
    border-color: rgb(84, 100, 124);
    background-color: rgb(58, 72, 92);
    color: rgb(231, 231, 231);
    -unity-text-align: middle-center;
    -unity-font-style: normal;
    transition-duration: 0.08s;
}

.tab-button:hover {
    background-color: rgb(74, 92, 116);
    border-color: rgb(109, 205, 255);
}

.tab-button--selected {
    background-color: rgb(74, 92, 116);
    border-width: 2px;
    border-color: rgb(109, 205, 255);
    color: rgb(109, 205, 255);
    -unity-font-style: bold;
}

.tab-button--secondary {
    margin-top: 18px;
}



.section-card {
    padding: 10px;
    margin-bottom: 12px;
    background-color: rgba(80, 140, 210, 0.10);
    border-radius: 0;
    border-width: 1px;
    border-color: rgb(84, 100, 124);
}

.field-row {
    margin-bottom: 6px;
    -unity-text-align: middle-left;
    color: rgb(231, 231, 231);
}

.field-wide {
    min-width: 300px;
}

.hint-text {
    white-space: normal;
    color: rgb(172, 190, 210);
    margin: 0 2px 6px;
}


.description-field {
    flex-direction: row;
    align-items: center;
}
.description-status-button {
    flex-grow: 1;
    min-width: 0;
    height: 20px;
    margin: 0;
    padding-left: 3px;
    padding-right: 3px;
    border-radius: 0;
    border-width: 1px;
    border-color: rgb(84, 100, 124);
    background-color: rgb(32, 39, 50);
    color: rgb(231, 231, 231);
    white-space: normal;
    -unity-text-align: middle-left;
}

.description-status-button:hover {
    background-color: rgb(32, 39, 50);
    border-color: rgb(109, 205, 255);
}

.description-status-button:active {
    background-color: rgb(32, 39, 50);
}

.description-status-button:disabled {
    background-color: rgb(32, 39, 50);
    border-color: rgb(70, 78, 88);
    color: rgb(140, 150, 160);
}



.action-button {
    height: 24px;
    margin-top: 4px;
    border-radius: 0;
    border-width: 1px;
    border-color: rgb(84, 100, 124);
    background-color: rgb(58, 72, 92);
    color: rgb(231, 231, 231);
}

.action-button:hover {
    background-color: rgb(74, 92, 116);
    border-color: rgb(109, 205, 255);
}

.action-button:active {
    background-color: rgb(46, 56, 70);
}

.button-group {
    align-items: stretch;
    margin-top: 6px;
}



.thumbnail-preview {
    width: 280px;
    height: 160px;
    margin: 12px 0;
    align-self: center;
    border-radius: 0;
    border-width: 2px;
    border-color: rgb(94, 112, 138);
    -unity-background-scale-mode: scale-and-crop;
    background-color: rgb(32, 39, 50);
}

.tag-list {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
    margin: 6px 0 16px;
}

.tag-button {
    display: none;
    margin: 0 4px 4px 0;
    font-size: 10px;
    border-radius: 0;
}


.TagBase {
    margin: 0 4px 4px 0;
    padding: 2px 8px;
    height: 20px;
    border-radius: 0;
    border-width: 1px;
    -unity-text-align: middle-center;
}


.Tag-Category {
    border-color: rgb(150, 130, 20);
    background-color: rgba(255, 231, 73, 0.18);
    color: rgb(255, 231, 73);
}

.Tag-Category:hover {
    background-color: rgba(255, 231, 73, 0.3);
}


.Tag-AccessType {
    border-color: rgb(150, 45, 45);
    background-color: rgba(255, 90, 90, 0.18);
    color: rgb(255, 120, 120);
}

.Tag-AccessType:hover {
    background-color: rgba(255, 90, 90, 0.3);
}


.Tag-AppType {
    border-color: rgb(160, 95, 20);
    background-color: rgba(255, 160, 70, 0.18);
    color: rgb(255, 175, 90);
}

.Tag-AppType:hover {
    background-color: rgba(255, 160, 70, 0.3);
}



.main-root .unity-base-field__label,
.main-root .unity-text-element {
    color: rgb(231, 231, 231);
}

.main-root .unity-base-field__input,
.main-root .unity-base-text-field__input,
.main-root .unity-base-popup-field__input {
    background-color: rgb(32, 39, 50);
    border-color: rgb(84, 100, 124);
    color: rgb(231, 231, 231);
}


.main-root .unity-base-text-field__input {
    --unity-cursor-color: rgb(231, 231, 231);
}

.main-root .unity-base-field__input:hover,
.main-root .unity-base-text-field__input:hover,
.main-root .unity-base-popup-field__input:hover {
    border-color: rgb(109, 205, 255);
}


.main-root .unity-toggle > .unity-toggle__input,
.main-root .unity-toggle > .unity-toggle__input:hover {
    background-color: transparent;
    border-width: 0;
}

.main-root .unity-toggle__checkmark {
    background-color: transparent;
    border-color: rgb(94, 112, 138);
    border-width: 1px;
    border-radius: 0;
    -unity-background-image-tint-color: rgb(231, 231, 231);
}

.main-root .unity-toggle:hover .unity-toggle__checkmark,
.main-root .unity-toggle:focus .unity-toggle__checkmark {
    border-color: rgb(109, 205, 255);
}

.main-root .unity-foldout__toggle .unity-toggle__checkmark {
    background-color: transparent;
    border-width: 0;
    -unity-background-image-tint-color: rgb(231, 231, 231);
}

.main-root .unity-base-popup-field__arrow {
    -unity-background-image-tint-color: rgb(231, 231, 231);
}

.main-root .unity-list-view,
.main-root .unity-list-view__footer {
    background-color: rgb(38, 47, 60);
    border-color: rgb(84, 100, 124);
    color: rgb(231, 231, 231);
}

.main-root .unity-list-view__footer {
    background-image: none;
    border-radius: 0;
}

.main-root .unity-collection-view__scroll-view,
.main-root .unity-collection-view--with-border {
    background-color: rgb(32, 39, 50);
    border-color: rgb(84, 100, 124);
}

.main-root .unity-collection-view__item {
    background-color: rgb(32, 39, 50);
}

.main-root .unity-collection-view__item--alternative-background {
    background-color: rgb(38, 47, 60);
}

.main-root .unity-collection-view__item:hover {
    background-color: rgb(46, 56, 70);
}

.main-root .unity-collection-view__item--selected,
.main-root .unity-collection-view__item--selected:hover,
.main-root .unity-collection-view:focus .unity-collection-view__item--selected,
.main-root .unity-collection-view:focus .unity-collection-view__item--selected:hover {
    background-color: rgb(58, 92, 122);
    color: rgb(231, 231, 231);
}

.main-root .unity-list-view__footer Button {
    background-image: none;
    background-color: rgb(58, 72, 92);
    border-width: 1px;
    border-color: rgb(84, 100, 124);
    color: rgb(231, 231, 231);
    border-radius: 0;
}

.main-root .unity-list-view__footer Button:hover {
    background-color: rgb(74, 92, 116);
    border-color: rgb(109, 205, 255);
}

.main-root .unity-list-view__footer Button:active {
    background-color: rgb(46, 56, 70);
}

.main-root .sdk-checkbox > .unity-toggle__input > .unity-toggle__checkmark {
    background-image: none;
    background-color: transparent;
}

.main-root .sdk-checkbox:checked > .unity-toggle__input > .unity-toggle__checkmark {
    background-image: resource("UIPackageResources/Images/d_checkmark.png");
    -unity-background-image-tint-color: rgb(109, 205, 255);
}


.main-root .unity-list-view__foldout-header > .unity-foldout__toggle {
    background-image: none;
    background-color: rgb(38, 47, 60);
    border-color: rgb(84, 100, 124);
    color: rgb(231, 231, 231);
}

.main-root .unity-list-view__foldout-header > .unity-foldout__toggle:hover,
.main-root .unity-list-view__foldout-header > .unity-foldout__toggle:focus,
.main-root .unity-list-view__foldout-header > .unity-foldout__toggle:active {
    background-color: rgb(46, 56, 70);
    border-color: rgb(109, 205, 255);
}

.main-root .unity-list-view__foldout-header > .unity-foldout__toggle > .unity-toggle__input,
.main-root .unity-list-view__foldout-header > .unity-foldout__toggle .unity-toggle__text {
    background-image: none;
    background-color: transparent;
    color: rgb(231, 231, 231);
}
