<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="Main" class="main-root">
        <ui:VisualElement name="Tabs" class="tabs-panel">
            <ui:Button text="Information" display-tooltip-when-elided="true" name="StartTabButton" class="tab-button" />
            <ui:Button text="Update SDK" display-tooltip-when-elided="true" name="UpdateSDKTabButton" class="tab-button" />
            <ui:Button text="Mod Management" display-tooltip-when-elided="true" name="CreateModTabButton" class="tab-button" />
            <ui:Button text="Steam Workshop" display-tooltip-when-elided="true" name="SteamWorkshopTabButton" class="tab-button" />
            <ui:Button text="Mod.IO" display-tooltip-when-elided="true" name="LogInTabButton" class="tab-button tab-button--secondary" />
            <ui:Button text="Search Mods" display-tooltip-when-elided="true" name="SearchModTabButton" class="tab-button" style="display: none;" />
            <ui:Button text="Mod.IO" display-tooltip-when-elided="true" name="UploadModTabButton" class="tab-button" style="display: none;" />
        </ui:VisualElement>
        <ui:VisualElement name="Content" class="content-panel">
            <ui:Label text="Welcome to Core Keepers&apos; ModSDK!" name="Title" class="window-title" />
            <ui:VisualElement name="StartView" class="view" style="display: flex;">
                <ui:Label text="First go to the &lt;link=UpdateSDKTabButton&gt;Update SDK&lt;/link&gt; menu and pull in the necessary game files from the &lt;i&gt;Core Keeper&lt;/i&gt; game folder, afterwards follow the Asset Ripper workflow from the &lt;link=gitbook&gt;&lt;color=#6DCDFF&gt;&lt;u&gt;GitBook&lt;/u&gt;&lt;/color&gt;&lt;/link&gt; modding guide.&#10;&#10;Once you&apos;ve updated the SDK and the Assets you can feel free to check out the examples mods made by us by extracting the Assets/Examples zip file into the same folder as the zip.&#10;&#10;You can create a Mod in the &lt;link=ModTabButton&gt;Mod Management&lt;/link&gt; menu. The typical workflow is to name and create the mod, which will construct the basic mod structure in the project at &quot;Assets/Mod_Name&quot;. Then you can add and modify mod files as you wish to create the desired functionality.&#10;&#10;Once you&apos;re ready to upload your mod you can head over to either the Steam Workshop or the Mod.IO page, depending on which platform you want to upload the mod to. Do the upload step again when you want to update the mod." display-tooltip-when-elided="true" name="StartViewText" enable-rich-text="true" class="info-text" />
            </ui:VisualElement>
            <ui:VisualElement name="UpdateSDKView" class="view">
                <ui:Label text="Select the path to Core Keepers&apos; install folder and Assets extracted by Asset Ripper, then press Update to import the latest modding resources into the ModSDK." display-tooltip-when-elided="true" name="UpdateSDKInfoText" enable-rich-text="true" tooltip="Always update Core Keeper files first, and Assets after, not the other way around!" class="info-text" />
                <ui:VisualElement class="section-card">
                    <ui:DropdownField label="Install Path" index="-1" name="UpdateSDKChooseGamePath" class="field-row field-wide" />
                    <ui:VisualElement name="UpdateSDKButtons" class="button-group">
                        <ui:Button text="Select path to Core Keeper Install" display-tooltip-when-elided="true" name="UpdateSDKChooseGamePathManually" class="action-button" />
                        <ui:Button text="Update Game Files" display-tooltip-when-elided="true" name="UpdateSDKUpdateButton" class="action-button" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="section-card">
                    <ui:DropdownField label="Assets Path" index="-1" name="UpdateAssetsChooseAssetRipperPath" class="field-row field-wide" />
                    <ui:VisualElement name="UpdateAssetsButtons" class="button-group">
                        <ui:Button text="Select path to Core Keeper Assets" display-tooltip-when-elided="true" name="UpdateAssetsChooseGamePathManually" class="action-button" />
                        <ui:Button text="Update Game Assets" display-tooltip-when-elided="true" name="UpdateAssetsUpdateButton" class="action-button" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="SearchModView" class="view">
                <ui:ListView focusable="true" />
            </ui:VisualElement>
            <ui:VisualElement name="SteamWorkshopView" class="view">
                <ui:Button text="Initialize Steam" name="SteamInitButton" class="action-button" />
                <ui:Button text="Open Steam Config" name="SteamConfigButton" class="action-button" />
                <ui:VisualElement name="SteamWorkshopViewContainer" style="flex-grow: 1;">
                    <ui:DropdownField label="Select a Built Mod" name="SteamBuiltModsDropdown" class="field-row" />
                    <ui:Label display-tooltip-when-elided="true" name="SteamExportGamePath" class="hint-text" />
                    <ui:TextField picking-mode="Ignore" label="Title" name="SteamWorkshopFolderName" class="field-row" />
                    <ui:VisualElement class="unity-base-field field-row description-field">
                        <ui:Label text="Description" class="unity-base-field__label" />
                        <ui:Button text="Checking description.txt..." name="SteamDescriptionStatus" tooltip="Steam Workshop descriptions are always loaded from description.txt in your mod's source folder." class="description-status-button" />
                    </ui:VisualElement>
                    <ui:TextField picking-mode="Ignore" label="File ID" name="SteamWorkshopFileID" tooltip="Set to 0 for a new file, set to Steam Workshops&apos; exact file ID if updating" class="field-row" />
                    <ui:DropdownField label="Mod Visibility" name="SteamVisibility" text="Select Tag for Steam Workshop" class="field-row" />
                    <uie:EnumField label="Tag Type" value="Center" type="UnityEngine.TextAlignment, UnityEngine.TextRenderingModule" name="SteamWorkshopTagType" class="field-row" />
                    <ui:DropdownField label="Tags" name="SteamWorkshopTags" text="Select Tag for Steam Workshop" class="field-row" />
                    <ui:VisualElement name="SteamWorkshopTagsList" picking-mode="Ignore" class="tag-list">
                        <ui:Button text="Button" name="TagBase" picking-mode="Ignore" class="tag-button" />
                    </ui:VisualElement>
                    <ui:Button text="Select Thumbnail for Mod" display-tooltip-when-elided="true" name="SteamThumbnailUploadButton" class="action-button" style="margin-top: 12px;" />
                    <ui:Image name="SteamThumbnailUpload" class="thumbnail-preview" />
                    <ui:Button text="Go to mod page" display-tooltip-when-elided="true" name="SteamGoToPageButton" class="action-button" />
                    <ui:Button text="Upload to Steam Workshop" display-tooltip-when-elided="true" name="SteamUploadModButton" class="action-button" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="UploadModView" class="view">
                <ui:DropdownField label="Select a Built Mod" index="-1" name="UploadModModList" class="field-row" />
                <ui:VisualElement name="UploadModForm">
                    <ui:VisualElement style="flex-direction: column;">
                        <ui:TextField picking-mode="Ignore" label="ID" name="UploadModID" readonly="true" style="display: none;" />
                        <ui:TextField picking-mode="Ignore" label="Name" name="UploadModName" readonly="false" style="display: none;" />
                        <ui:TextField picking-mode="Ignore" label="URL" name="UploadModURL" readonly="false" style="display: none;" />

                        <ui:TextField picking-mode="Ignore" label="Title" name="UploadModTitle" class="field-row" />
                        <ui:TextField picking-mode="Ignore" label="Description" name="UploadModSummary" class="field-row" />
                        <ui:DropdownField label="Mod Visibility" name="UploadModVisibility" class="field-row" />
                        <uie:EnumField label="Tag Type" value="Center" type="UnityEngine.TextAlignment, UnityEngine.TextRenderingModule" name="UploadModTagType" class="field-row" />
                        <ui:DropdownField label="Tags" name="UploadModTagsDropdown" class="field-row" />
                        <ui:VisualElement name="UploadModTagsList" picking-mode="Ignore" class="tag-list" />
                        <ui:Button text="Select Thumbnail for Mod" display-tooltip-when-elided="true" name="UploadModLogoButton" class="action-button" style="margin-top: 12px;" />
                        <ui:VisualElement name="UploadModLogo" class="thumbnail-preview" />

                        <ui:Button text="Register at mod.io" display-tooltip-when-elided="true" name="CreateModProfile" class="action-button" />
                        <ui:Button text="Go to mod page" display-tooltip-when-elided="true" name="GoToProfileButton" class="action-button" />
                        <ui:Button text="Upload to mod.io" display-tooltip-when-elided="true" name="UploadModButton" class="action-button" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="CreateModView" class="view">
                <ui:DropdownField label="Mod Select" index="-1" name="CreateModModList" choices="New Mod" class="field-row field-wide" />
                <ui:VisualElement name="CreateModForm" class="section-card">
                    <ui:TextField picking-mode="Ignore" label="Mod Name" name="CreateModName" readonly="false" class="field-row field-wide" />
                    <ui:VisualElement style="align-items: center; margin-top: 10px;">
                        <ui:Button text="Create Mod" display-tooltip-when-elided="true" name="CreateModButton" class="action-button" style="width: 200px;" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="LocalExportForm">
                    <ui:VisualElement name="ModSettings" class="section-card">
                        <ui:Toggle label="Require for multiplayer" name="RequiredOnServerAndClient" tooltip="Will enforce the mod to be present for connecting clients as well" class="field-row sdk-checkbox" />
                        <ui:ListView focusable="true" name="ModDependencies" show-foldout-header="true" show-add-remove-footer="true" header-title="Dependencies" reorderable="true" reorder-mode="Simple" show-border="true" virtualization-method="DynamicHeight" show-alternating-row-backgrounds="All" />
                    </ui:VisualElement>
                    <ui:Label display-tooltip-when-elided="true" name="LocalExportGamePath" text="Go to &apos;Update SDK&apos; to set correct path for mod loading." class="hint-text" />
                    <ui:Button text="Build Mod" display-tooltip-when-elided="true" name="BuildingButton" class="action-button" />
                    <ui:Button text="Install Mod" display-tooltip-when-elided="true" name="InstallModButton" class="action-button" />
                    <ui:Button text="Uninstall Mod" display-tooltip-when-elided="true" name="UninstallModButton" class="action-button" />
                    <ui:Button text="Build and Install Mod" display-tooltip-when-elided="true" name="LocalExportButton" class="action-button" />
                    <ui:Button text="Open Last Build/Install Folder" display-tooltip-when-elided="true" name="OpenLastBuildFolderButton" class="action-button" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
